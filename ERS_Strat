// ══════════════════════════════════════════════════════════════════════════════
//  SILVERMIC · Expansion Regime Swing Strategy  [ERS v1.0]
//  Designed for MCX SILVERMIC — Daily or 4H timeframe recommended
//  Target: Hold multi-day momentum swings in confirmed expansion regimes
//
//  MATHEMATICAL FRAMEWORK:
//  ─────────────────────────────────────────────────────────────────────────
//  Regime Score (0–5):
//    1. ADX(14) > 22                  → Directional momentum present
//    2. ATR(14) / SMA(ATR,50) ≥ 1.10 → Volatility expanding vs baseline
//    3. BB_Width > SMA(BB_Width,50)   → Bands widening (expansion phase)
//    4. EMA(21/50/200) aligned        → Structural trend coherence
//    5. Norm. LR Slope > ±0.10        → Statistically significant slope
//
//  Entry (requires score ≥ 3):
//    Breakout : Close above/below N-bar swing high/low + MACD + RSI guard
//    Pullback : Price touches EMA21, then resumes in trend direction
//
//  Exit:
//    - ATR Chandelier Trailing Stop (ratchets in trend direction)
//    - Fixed ATR Take Profit ceiling
//    - Regime Collapse: score drops below 2 → immediate close
//
//  Risk:
//    - Initial SL  : 1.5× ATR from entry
//    - Trail Stop  : 2.5× ATR (Chandelier style)
//    - Take Profit : 4.0× ATR  →  implied R:R ≈ 2.67:1
// ══════════════════════════════════════════════════════════════════════════════

//@version=5
strategy("SILVERMIC · Expansion Regime Swing [ERS]",
     shorttitle              = "SILVERMIC·ERS",
     overlay                 = true,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 10,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 5,
     slippage                = 2,
     calc_on_every_tick      = false,
     process_orders_on_close = true)


// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ─── Regime Detection ───────────────────────────────────────────────────────
adx_len          = input.int   (14,    "ADX Length",             group="⚙ Regime Detection", minval=5)
adx_thresh       = input.float (22.0,  "ADX Threshold",          group="⚙ Regime Detection", step=0.5,                                tooltip="ADX above this level → directional momentum active (classic = 25; 22 gives earlier signal)")
atr_len          = input.int   (14,    "ATR Length",             group="⚙ Regime Detection", minval=5)
atr_base_len     = input.int   (50,    "ATR Baseline MA",        group="⚙ Regime Detection",                                tooltip="SMA length to establish ATR mean. Ratio = Current ATR / this MA")
atr_exp_thresh   = input.float (1.10,  "ATR Expansion Ratio",    group="⚙ Regime Detection", step=0.05,                                tooltip="ATR/Baseline > this value confirms volatility expansion (1.10 = 10% above mean)")
bb_len           = input.int   (20,    "BB Length",              group="⚙ Regime Detection")
bb_mult          = input.float (2.0,   "BB Multiplier",          group="⚙ Regime Detection", step=0.1)
bb_base_len      = input.int   (50,    "BB Width Baseline MA",   group="⚙ Regime Detection",                                tooltip="BB Width vs this MA baseline determines expansion phase")

// ─── Trend Filters ──────────────────────────────────────────────────────────
ema_fast         = input.int   (21,    "Fast EMA",               group="📈 Trend Filter")
ema_mid          = input.int   (50,    "Mid EMA",                group="📈 Trend Filter")
ema_slow         = input.int   (200,   "Slow EMA",               group="📈 Trend Filter")
lr_len           = input.int   (20,    "LR Slope Length",        group="📈 Trend Filter")
lr_thresh        = input.float (0.10,  "Norm. LR Slope Threshold", group="📈 Trend Filter", step=0.01,                                tooltip="Slope / ATR must exceed this. 0.10 = price moves >10% of ATR per bar in trend direction")

// ─── Entry ──────────────────────────────────────────────────────────────────
swing_lb         = input.int   (20,    "Swing High/Low Lookback",group="🎯 Entry")
rsi_len          = input.int   (14,    "RSI Length",             group="🎯 Entry")
min_score        = input.int   (3,     "Min Regime Score (0–5)", group="🎯 Entry", minval=1, maxval=5,                                tooltip="Regime score must reach this threshold before entries are allowed")
use_breakout     = input.bool  (true,  "Enable Breakout Entries",group="🎯 Entry")
use_pullback     = input.bool  (true,  "Enable Pullback Entries",group="🎯 Entry")
use_shorts       = input.bool  (true,  "Enable Short Trades",    group="🎯 Entry")

// ─── Risk Management ────────────────────────────────────────────────────────
sl_mult          = input.float (1.5,   "Initial SL (× ATR)",    group="🛡 Risk Management", step=0.1)
trail_mult       = input.float (2.5,   "Trail Stop (× ATR)",    group="🛡 Risk Management", step=0.1,                                tooltip="Chandelier trailing stop width. Ratchets in trade direction to lock profits")
tp_mult          = input.float (4.0,   "Take Profit (× ATR)",   group="🛡 Risk Management", step=0.25,                                tooltip="Fixed ATR target. R:R = tp_mult / sl_mult (default: 4.0/1.5 ≈ 2.67:1)")
regime_exit_min  = input.int   (2,     "Exit if Score drops <",  group="🛡 Risk Management", minval=0, maxval=5,                                tooltip="Close position immediately if regime score falls below this value (expansion collapsed)")


// ══════════════════════════════════════════════════════════════════════════════
//  CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

// ─── ATR ────────────────────────────────────────────────────────────────────
atr_val  = ta.atr(atr_len)
atr_base = ta.sma(atr_val, atr_base_len)
atr_ratio = atr_val / atr_base

// ─── ADX / DMI (Wilder) ─────────────────────────────────────────────────────
[diplus, diminus, adx_val] = ta.dmi(adx_len, adx_len)
di_bull = diplus  > diminus   // +DI dominant  → bullish direction
di_bear = diminus > diplus    // -DI dominant  → bearish direction

// ─── Bollinger Bands & Width ─────────────────────────────────────────────────
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
bb_width     = (bb_upper - bb_lower) / bb_mid  // Normalized BB width
bb_width_avg = ta.sma(bb_width, bb_base_len)

// ─── EMA Stack ───────────────────────────────────────────────────────────────
ema21  = ta.ema(close, ema_fast)
ema50  = ta.ema(close, ema_mid)
ema200 = ta.ema(close, ema_slow)

// ─── MACD (momentum confirmation) ───────────────────────────────────────────
[macd_line, macd_sig, macd_hist] = ta.macd(close, 12, 26, 9)

// ─── RSI (overbought / oversold guard) ───────────────────────────────────────
rsi_val = ta.rsi(close, rsi_len)

// ─── Normalized Linear Regression Slope ─────────────────────────────────────
//  Raw slope = LinReg value on this bar minus value on previous bar
//  Normalized = raw slope / ATR  →  removes heteroscedasticity
//  Interpretation: > 0.10 means price direction equivalent to >10% ATR/bar
lr_slope_raw  = ta.linreg(close, lr_len, 0) - ta.linreg(close, lr_len, 1)
lr_slope_norm = lr_slope_raw / atr_val


// ══════════════════════════════════════════════════════════════════════════════
//  REGIME SCORE COMPUTATION
// ══════════════════════════════════════════════════════════════════════════════

// Boolean components
adx_ok      = adx_val     > adx_thresh
atr_exp_ok  = atr_ratio   >= atr_exp_thresh
bb_exp_ok   = bb_width    > bb_width_avg
ema_bull_ok = ema21 > ema50 and ema50 > ema200
ema_bear_ok = ema21 < ema50 and ema50 < ema200
lr_bull_ok  = lr_slope_norm >  lr_thresh
lr_bear_ok  = lr_slope_norm < -lr_thresh

// Composite score (0–5)
// Shared factors: ADX + ATR expansion + BB expansion
// Directional factors: EMA alignment + LR slope (differ for bull/bear)
score_bull = (adx_ok ? 1 : 0) + (atr_exp_ok ? 1 : 0) + (bb_exp_ok ? 1 : 0) +
             (ema_bull_ok ? 1 : 0) + (lr_bull_ok ? 1 : 0)

score_bear = (adx_ok ? 1 : 0) + (atr_exp_ok ? 1 : 0) + (bb_exp_ok ? 1 : 0) +
             (ema_bear_ok ? 1 : 0) + (lr_bear_ok ? 1 : 0)

// Active regime flags
is_bull_exp = score_bull >= min_score and di_bull
is_bear_exp = score_bear >= min_score and di_bear and use_shorts


// ══════════════════════════════════════════════════════════════════════════════
//  ENTRY SIGNALS
// ══════════════════════════════════════════════════════════════════════════════

swing_hi = ta.highest(high, swing_lb)[1]  // [1] avoids look-ahead
swing_lo = ta.lowest (low,  swing_lb)[1]

// ─── Breakout Entries ────────────────────────────────────────────────────────
// Long breakout: close decisively above the swing high
//   + regime confirmed bull
//   + MACD histogram rising or line above signal
//   + RSI in momentum zone (not yet overbought)
long_bo  = use_breakout and is_bull_exp and
           close > swing_hi and
           macd_line > macd_sig and
           rsi_val > 45 and rsi_val < 78

// Short breakout: close below swing low with mirror conditions
short_bo = use_breakout and is_bear_exp and
           close < swing_lo and
           macd_line < macd_sig and
           rsi_val < 55 and rsi_val > 22

// ─── Pullback Entries ────────────────────────────────────────────────────────
// Long pullback: price retraced to EMA21 (within 0.3%), then resumed upward
//   Requires close above EMA21 on current bar (confirming the bounce)
long_pb  = use_pullback and is_bull_exp and
           close > ema21 and
           low[1] <= ema21 * 1.003 and  // previous bar touched EMA21 zone
           close > open and              // bullish close (price resumed)
           rsi_val > 38 and rsi_val < 70

// Short pullback: price rallied to EMA21, then resumed downward
short_pb = use_pullback and is_bear_exp and
           close < ema21 and
           high[1] >= ema21 * 0.997 and
           close < open and
           rsi_val < 62 and rsi_val > 30

// Final entry flags (no entry if already in a trade)
long_entry  = (long_bo  or long_pb)  and strategy.position_size == 0
short_entry = (short_bo or short_pb) and strategy.position_size == 0


// ══════════════════════════════════════════════════════════════════════════════
//  POSITION VARIABLES
// ══════════════════════════════════════════════════════════════════════════════

var float long_sl     = na  // Active long stop-loss level
var float long_tp     = na  // Active long take-profit level
var float long_trail  = na  // Active long trailing stop (Chandelier)
var float short_sl    = na
var float short_tp    = na
var float short_trail = na


// ══════════════════════════════════════════════════════════════════════════════
//  TRADE EXECUTION
// ══════════════════════════════════════════════════════════════════════════════

// ─── Long Entry ──────────────────────────────────────────────────────────────
if long_entry
    long_sl    := close - sl_mult    * atr_val
    long_tp    := close + tp_mult    * atr_val
    long_trail := close - trail_mult * atr_val
    strategy.entry("Long", strategy.long,
                   comment = long_bo ? "L_Breakout" : "L_Pullback")

// ─── Short Entry ─────────────────────────────────────────────────────────────
if short_entry
    short_sl    := close + sl_mult    * atr_val
    short_tp    := close - tp_mult    * atr_val
    short_trail := close + trail_mult * atr_val
    strategy.entry("Short", strategy.short,
                   comment = short_bo ? "S_Breakout" : "S_Pullback")

// ─── Update Chandelier Trailing Stops ────────────────────────────────────────
// Ratchet up (long): trail can only move higher, never lower
if strategy.position_size > 0
    new_long_trail = close - trail_mult * atr_val
    long_trail    := math.max(nz(long_trail, long_sl), new_long_trail)
    long_trail    := math.max(long_trail, nz(long_sl))  // never below initial SL

// Ratchet down (short): trail can only move lower, never higher
if strategy.position_size < 0
    new_short_trail = close + trail_mult * atr_val
    short_trail    := math.min(nz(short_trail, short_sl), new_short_trail)
    short_trail    := math.min(short_trail, nz(short_sl, 1e9))

// ─── Place Exit Orders (updated each bar) ────────────────────────────────────
if strategy.position_size > 0 and not na(long_trail)
    strategy.exit("Long Exit", "Long",
                  stop    = long_trail,
                  limit   = long_tp,
                  comment = "LX_Trail")

if strategy.position_size < 0 and not na(short_trail)
    strategy.exit("Short Exit", "Short",
                  stop    = short_trail,
                  limit   = short_tp,
                  comment = "SX_Trail")

// ─── Regime Collapse Exit ────────────────────────────────────────────────────
// If the expansion regime deteriorates while in a trade, exit immediately.
// This prevents holding through the transition back to contraction/chop.
if strategy.position_size > 0 and score_bull < regime_exit_min
    strategy.close("Long",  comment = "Regime Collapse")

if strategy.position_size < 0 and score_bear < regime_exit_min
    strategy.close("Short", comment = "Regime Collapse")

// ─── Reset on Flat Position ──────────────────────────────────────────────────
if strategy.position_size == 0
    long_sl     := na
    long_tp     := na
    long_trail  := na
    short_sl    := na
    short_tp    := na
    short_trail := na


// ══════════════════════════════════════════════════════════════════════════════
//  VISUALS
// ══════════════════════════════════════════════════════════════════════════════

// ─── EMA Plots ───────────────────────────────────────────────────────────────
plot(ema21,  "EMA 21",  color=color.new(color.yellow, 0),  linewidth=1)
plot(ema50,  "EMA 50",  color=color.new(color.orange, 0),  linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red,    0),  linewidth=2)

// ─── Bollinger Bands (subtle reference) ──────────────────────────────────────
p_upper = plot(bb_upper, "BB Upper", color=color.new(color.gray, 72), linewidth=1)
p_lower = plot(bb_lower, "BB Lower", color=color.new(color.gray, 72), linewidth=1)
fill(p_upper, p_lower, color=color.new(color.gray, 92))

// ─── Swing High / Low Reference ──────────────────────────────────────────────
plot(swing_hi, "Swing High", color=color.new(color.aqua,   60), style=plot.style_circles, linewidth=1)
plot(swing_lo, "Swing Low",  color=color.new(color.purple, 60), style=plot.style_circles, linewidth=1)

// ─── Regime Background Shading ───────────────────────────────────────────────
bgcolor(is_bull_exp and not is_bear_exp ? color.new(color.lime,  91) : na, title="Bull Expansion")
bgcolor(is_bear_exp and not is_bull_exp ? color.new(color.red,   91) : na, title="Bear Expansion")

// ─── Entry Signal Arrows ─────────────────────────────────────────────────────
plotshape(long_entry,  "Long Signal",  shape.triangleup,   location.belowbar,
          color.new(color.lime, 0),  size=size.normal,  text="BUY")
plotshape(short_entry, "Short Signal", shape.triangledown, location.abovebar,
          color.new(color.red,  0),  size=size.normal,  text="SELL")

// ─── Trailing Stop Line ───────────────────────────────────────────────────────
plot(strategy.position_size > 0  ? long_trail  : na,
     "Long Trail Stop",  color=color.new(color.lime, 15), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0  ? short_trail : na,
     "Short Trail Stop", color=color.new(color.red,  15), linewidth=2, style=plot.style_linebr)

// ─── TP Level Line ────────────────────────────────────────────────────────────
plot(strategy.position_size > 0  ? long_tp  : na,
     "Long TP",   color=color.new(color.teal,   30), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size < 0  ? short_tp : na,
     "Short TP",  color=color.new(color.orange, 30), linewidth=1, style=plot.style_linebr)

// ─── Regime Score Bar-color Override ─────────────────────────────────────────
// High-score bars get bright coloring for quick visual reference
barcolor(score_bull >= 4 ? color.new(color.lime, 30) :
         score_bear >= 4 ? color.new(color.red,  30) : na,
         title="High-Score Bar")


// ══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD TABLE  (top-right)
// ══════════════════════════════════════════════════════════════════════════════
var table dash = table.new(
     position.top_right, 2, 12,
     bgcolor      = color.new(color.black, 72),
     border_width = 1, border_color = color.new(color.gray, 55),
     frame_width  = 1, frame_color  = color.new(color.gray, 45))

if barstate.islast
    // Regime label
    reg_str = is_bull_exp ? "BULL EXPANSION" : is_bear_exp ? "BEAR EXPANSION" : "NO REGIME"
    reg_col = is_bull_exp ? color.lime : is_bear_exp ? color.red : color.gray

    // Position label
    pos_str = strategy.position_size > 0 ? "LONG  ▲" : strategy.position_size < 0 ? "SHORT ▼" : "FLAT"
    pos_col = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray

    // R:R display
    rr_display = str.tostring(math.round(tp_mult / sl_mult, 2)) + " : 1"

    // Row 0 — Header
    table.cell(dash, 0, 0,  "SILVERMIC · ERS",   text_color=color.white,
               bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(dash, 1, 0,  "v1.0",              text_color=color.gray,
               bgcolor=color.new(color.navy, 30), text_size=size.small)

    // Row 1 — Regime
    table.cell(dash, 0, 1,  "Regime",            text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1,  reg_str,             text_color=reg_col,      text_size=size.small)

    // Row 2 — Bull Score
    table.cell(dash, 0, 2,  "Bull Score",        text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2,  str.tostring(score_bull) + " / 5",
               text_color = score_bull >= min_score ? color.lime : color.new(color.gray, 20),
               text_size  = size.small)

    // Row 3 — Bear Score
    table.cell(dash, 0, 3,  "Bear Score",        text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3,  str.tostring(score_bear) + " / 5",
               text_color = score_bear >= min_score ? color.red : color.new(color.gray, 20),
               text_size  = size.small)

    // Row 4 — ADX
    table.cell(dash, 0, 4,  "ADX",               text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4,  str.tostring(math.round(adx_val, 1)),
               text_color = adx_ok ? color.lime : color.new(color.gray, 25),
               text_size  = size.small)

    // Row 5 — ATR Ratio
    table.cell(dash, 0, 5,  "ATR Ratio",         text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5,  str.tostring(math.round(atr_ratio, 3)),
               text_color = atr_exp_ok ? color.lime : color.new(color.gray, 25),
               text_size  = size.small)

    // Row 6 — BB Width
    table.cell(dash, 0, 6,  "BB Width %",        text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6,  str.tostring(math.round(bb_width * 100, 2)) + "%",
               text_color = bb_exp_ok ? color.lime : color.new(color.gray, 25),
               text_size  = size.small)

    // Row 7 — EMA Stack
    table.cell(dash, 0, 7,  "EMA Stack",         text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7,
               ema_bull_ok ? "BULL ✓" : ema_bear_ok ? "BEAR ✓" : "Mixed ✗",
               text_color = (ema_bull_ok or ema_bear_ok) ? color.lime : color.new(color.gray, 25),
               text_size  = size.small)

    // Row 8 — LR Slope
    table.cell(dash, 0, 8,  "LR Slope (norm)",   text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8,  str.tostring(math.round(lr_slope_norm, 3)),
               text_color = (lr_bull_ok or lr_bear_ok) ? color.lime : color.new(color.gray, 25),
               text_size  = size.small)

    // Row 9 — RSI
    table.cell(dash, 0, 9,  "RSI",               text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9,  str.tostring(math.round(rsi_val, 1)),
               text_color = color.white,
               text_size  = size.small)

    // Row 10 — R:R
    table.cell(dash, 0, 10, "R : R ratio",       text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 10, rr_display,           text_color=color.yellow, text_size=size.small)

    // Row 11 — Current Position
    table.cell(dash, 0, 11, "Position",           text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 11, pos_str,              text_color=pos_col,      text_size=size.small)


// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(long_entry,  "ERS Long Entry",  "SILVERMIC ERS: LONG entry")
alertcondition(short_entry, "ERS Short Entry", "SILVERMIC ERS: SHORT entry")
alertcondition(strategy.position_size > 0 and score_bull < regime_exit_min,
               "ERS Regime Exit Long",  "SILVERMIC ERS: Bull regime collapsed — closing LONG")
alertcondition(strategy.position_size < 0 and score_bear < regime_exit_min,
               "ERS Regime Exit Short", "SILVERMIC ERS: Bear regime collapsed — closing SHORT")

// ══════════════════════════════════════════════════════════════════════════════
//  END
// ══════════════════════════════════════════════════════════════════════════════
